{
  "name": "sts32xx-firmware",
  "version": "1.0.0",
  "private": true,
  "description": "GD32F130 STS firmware and generic host interfaces",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test host/servo-driver/test/*.test.js tools/teleoperation/test/*.test.js tools/diagnostics/test/*.test.js tools/hw-diff-tests/test/*.test.js tools/settings/test/*.test.js tools/pose-recorder/test/*.test.js host/arm-control/test/*.test.js tools/tuning/test/*.test.js",
    "test:diff": "node --test tools/hw-diff-tests/test/*.test.js",
    "diff": "node tools/hw-diff-tests/src/cli.js",
    "test:diagnostics": "node --test tools/diagnostics/test/*.test.js",
    "bus-benchmark": "node tools/diagnostics/bus-benchmark.js",
    "telemetry": "node tools/diagnostics/telemetry.js",
    "settings": "node tools/settings/cli.js",
    "test:settings": "node --test tools/settings/test/*.test.js",
    "test:driver": "npm test --workspace sts32xx-servo-driver",
    "test:driver-package": "npm run test:package --workspace sts32xx-servo-driver",
    "record-poses": "node tools/pose-recorder/cli.js",
    "test:poses": "node --test tools/pose-recorder/test/*.test.js",
    "teleoperate": "node tools/teleoperation/cli.js",
    "test:teleoperation": "node --test tools/teleoperation/test/*.test.js",
    "replay-poses": "node tools/pose-recorder/replay.js",
    "test:arm": "node --test host/arm-control/test/*.test.js",
    "test:tuning": "node --test tools/tuning/test/*.test.js",
    "tune": "node tools/tuning/cli.js"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "workspaces": [
    "host/servo-driver"
  ]
}
