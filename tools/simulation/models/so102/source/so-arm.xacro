<!-- Positive-Y / left claw. -->
<link name="clamp1_1">
  <inertial>
    <origin xyz="0.015089611631717736 0.052019408526296096 -0.01364049960713011" rpy="0 0 0"/>
    <mass value="0.0827491781431124"/>
    <inertia ixx="2e-05" iyy="5.6e-05" izz="3.9e-05" ixy="-4e-06" iyz="0.0" ixz="1e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.409377 0.043099 -0.112532" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://so-arm_description/meshes/clamp1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.409377 0.043099 -0.112532" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://so-arm_description/meshes/clamp1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="base_to_link1" type="revolute">
  <origin xyz="-0.006 0.0 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link1_1"/>
  <axis xyz="-0.0 -0.0 -1.0"/>
  <limit upper="3.071779" lower="-3.071779" effort="100" velocity="100"/>
</joint>

<joint name="link1_to_link2" type="revolute">
  <origin xyz="0.04 -0.018 0.073357" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <limit upper="3.159046" lower="-0.750492" effort="100" velocity="100"/>
</joint>

<joint name="link2_to_link3" type="revolute">
  <origin xyz="0.113001 0.036 -3.4e-05" rpy="0 0 0"/>
  <parent link="link2_1"/>
  <child link="link3_1"/>
  <axis xyz="0.0 -1.0 -0.0"/>
  <limit upper="1.343904" lower="-2.897247" effort="100" velocity="100"/>
</joint>

<joint name="link3_to_link4" type="revolute">
  <origin xyz="0.139185 0.0 -3.6e-05" rpy="0 0 0"/>
  <parent link="link3_1"/>
  <child link="link4_1"/>
  <axis xyz="-0.0 1.0 0.0"/>
  <limit upper="1.937315" lower="-1.48353" effort="100" velocity="100"/>
</joint>

<joint name="link4_to_link5" type="revolute">
  <origin xyz="0.059194 -0.018001 -4e-05" rpy="0 0 0"/>
  <parent link="link4_1"/>
  <child link="link5_1"/>
  <axis xyz="-1.0 -0.0 0.0"/>
  <limit upper="2.844887" lower="-2.879793" effort="100" velocity="100"/>
</joint>

<joint name="clamp1" type="prismatic">
  <!-- The joint frame is placed at the fully-open pose. -->
  <origin xyz="0.063997 -0.000498 0.014285" rpy="0 0 0"/>
  <parent link="link5_1"/>
  <child link="clamp1_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <limit upper="0.0425" lower="0.0" effort="100" velocity="100"/>
</joint>

<joint name="clamp2" type="prismatic">
  <!-- The joint frame is placed at the fully-open pose. -->
  <origin xyz="0.063997 0.001502 0.014285" rpy="0 0 0"/>
  <parent link="link5_1"/>
  <child link="clamp2_1"/>
  <!-- Positive displacement closes both claws. -->
  <axis xyz="0.0 1.0 0.0"/>
  <limit upper="0.0425" lower="0.0" effort="100" velocity="100"/>
  <!-- The opposite axis makes the same displacement mirror clamp1 physically. -->
  <mimic joint="clamp1" multiplier="1.0" offset="0.0"/>
</joint>

</robot>
