  <inertial>
    <origin xyz="0.03159105739141316 -0.010094336391021686 -0.0001713219399298166" rpy="0 0 0"/>
    <mass value="0.47315362223870805"/>
    <inertia ixx="0.000177" iyy="0.00017" izz="0.000277" ixy="-2.8e-05" iyz="1e-06" ixz="2e-06"/>
