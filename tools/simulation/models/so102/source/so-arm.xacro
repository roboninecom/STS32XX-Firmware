<?xml version="1.0" ?>
<robot name="so-arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find so-arm_description)/urdf/materials.xacro" />
<xacro:include filename="$(find so-arm_description)/urdf/so-arm.trans" />

<link name="base_link">
