<!-- Negative-Y / right claw. -->
<link name="clamp2_1">
  <inertial>
    <origin xyz="0.015089611475487041 -0.05201855841456542 -0.014925662643598639" rpy="0 0 0"/>
    <mass value="0.08274917910303048"/>
    <inertia ixx="2e-05" iyy="5.6e-05" izz="3.9e-05" ixy="4e-06" iyz="0.0" ixz="-1e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.409377 -0.044101 -0.112532" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://so-arm_description/meshes/clamp2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
