<joint name="base_to_link1" type="revolute">
  <origin xyz="-0.006 0.0 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link1_1"/>
  <axis xyz="-0.0 -0.0 -1.0"/>
  <limit upper="3.071779" lower="-3.071779" effort="100" velocity="100"/>
</joint>

<joint name="link1_to_link2" type="revolute">
  <origin xyz="0.04 -0.018 0.073357" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <limit upper="3.159046" lower="-0.750492" effort="100" velocity="100"/>
</joint>

<joint name="link2_to_link3" type="revolute">
  <origin xyz="0.113001 0.036 -3.4e-05" rpy="0 0 0"/>
  <parent link="link2_1"/>
  <child link="link3_1"/>
  <axis xyz="0.0 -1.0 -0.0"/>
  <limit upper="1.343904" lower="-2.897247" effort="100" velocity="100"/>
</joint>

<joint name="link3_to_link4" type="revolute">
