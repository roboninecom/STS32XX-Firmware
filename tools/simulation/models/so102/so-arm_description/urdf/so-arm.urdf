<?xml version="1.0" ?>
<!-- PROVISIONAL SIMULATION INERTIALS: measured total; assumed mass placement, original CAD centers and scaled tensors. NOT FOR HARDWARE FEEDFORWARD. -->
<robot name="so-arm">

<material name="silver">
